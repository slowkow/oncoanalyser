/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ESVEE: run the Rust port (esvee-rs) in place of Java ESVEE
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_esvee` and `rust_ports` profiles. The image's `esvee` command takes
    the same options as Java ESVEE and runs prep, assembly, depth and caller in one call.
    On a whole genome esvee-rs peaks at about 7 GB plus the mapped genome image (5-6 GB).
----------------------------------------------------------------------------------------
*/

process {
    withName: 'ESVEE' {
        container = params.rust_ports_container
        memory    = { 24.GB * task.attempt }
    }
}

env {
    ESVEE_JAVA_COMPAT = params.rust_java_compat ? '1' : '0'
}
