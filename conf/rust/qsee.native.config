// Included by qsee.config when --rust_ports_bin is given: run the port from that folder on the host (with R on
// the host's PATH it draws the report too, through the jar's R script, as Java does)
process {
    withName: 'QSEE' {
        container    = null
        beforeScript = "export PATH=\"${params.rust_ports_bin}:\$PATH\""
    }
}
