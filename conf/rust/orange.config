/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ORANGE: run the Rust port (orange-rs) in place of Java ORANGE
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_orange` and `rust_ports` profiles. The image's `orange` command takes Java ORANGE 5.1's
    options and writes the JSON report and the plot copies; it does not write the PDF (an optional output of this
    step). oncoanalyser runs ORANGE only when PURPLE's circos plot exists, so with rust_purple (no plots yet) the
    step is skipped either way. orange-rs peaks at about 50 MB (Java: 0.7-0.9 GB, mostly the PDF).
----------------------------------------------------------------------------------------
*/

process {
    withName: 'ORANGE' {
        // -java_compat (Java's behaviour) from --rust_java_compat, on the command line: Google Batch does not
        // pass the env scope to tasks. Empty when not set, so the task script (and the -resume cache) is
        // then the same as without this line.
        ext.args  = { params.rust_java_compat ? '-java_compat' : '' }
        // a closure, read as each task starts, so that a value set in a -c config counts too
        // (Nextflow then warns once at start-up that the parameter is undefined; harmless)
        container = { params.rust_ports_container }
        memory    = { 1.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container. Kept in its
// own file so that beforeScript is only set then: setting it here, even to null, would replace a
// beforeScript the run's own config gives every process (such as the Google Batch `mv` workaround).
includeConfig params.rust_ports_bin ? 'orange.native.config' : '/dev/null'
