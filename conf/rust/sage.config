/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SAGE: run the Rust port (sage-rs) in place of Java SAGE
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_sage` and `rust_ports` profiles. The image's `sage` command takes the
    same options as Java SAGE. sage-rs peaks below 2 GB on a whole genome.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'SAGE_(SOMATIC|GERMLINE|APPEND_SOMATIC|APPEND_GERMLINE)' {
        // -low_base_qual_threshold and -high_base_qual_threshold (options of the port, not of Java) from
        // --rust_low_base_qual_threshold and --rust_high_base_qual_threshold; empty when neither is set
        // (the task script, and so the -resume cache, is then the same as without these lines)
        ext.args = {
            [
                params.rust_low_base_qual_threshold  != null ? "-low_base_qual_threshold ${params.rust_low_base_qual_threshold}"   : '',
                params.rust_high_base_qual_threshold != null ? "-high_base_qual_threshold ${params.rust_high_base_qual_threshold}" : '',
            ].findAll().join(' ')
        }
    }
    withName: 'SAGE_(SOMATIC|GERMLINE|APPEND_SOMATIC|APPEND_GERMLINE|VISUALISER)' {
        // a closure, read as each task starts, so that a value set in a -c config counts too
        // (Nextflow then warns once at start-up that the parameter is undefined; harmless)
        container = { params.rust_ports_container }
        memory    = { 8.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container. Kept in its
// own file so that beforeScript is only set then: setting it here, even to null, would replace a
// beforeScript the run's own config gives every process (such as the Google Batch `mv` workaround).
includeConfig params.rust_ports_bin ? 'sage.native.config' : '/dev/null'

env {
    SAGE_JAVA_COMPAT = params.rust_java_compat ? '1' : '0'
}
