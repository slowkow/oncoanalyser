/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SAGE: run the Rust port (sage-rs) in place of Java SAGE
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_sage` and `rust_ports` profiles. The image's `sage` command takes the
    same options as Java SAGE. sage-rs peaks below 2 GB on a whole genome.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'SAGE_(SOMATIC|GERMLINE|APPEND_SOMATIC|APPEND_GERMLINE|VISUALISER)' {
        container = params.rust_ports_container
        memory    = { 8.GB * task.attempt }
    }
}

env {
    SAGE_JAVA_COMPAT = params.rust_java_compat ? '1' : '0'
}
