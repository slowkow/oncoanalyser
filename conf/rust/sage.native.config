// Included by sage.config when --rust_ports_bin is given: run the port from that folder on the host
process {
    withName: 'SAGE_(SOMATIC|GERMLINE|APPEND_SOMATIC|APPEND_GERMLINE|VISUALISER)' {
        container    = null
        beforeScript = "export PATH=\"${params.rust_ports_bin}:\$PATH\""
    }
}
