/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REDUX: run the Rust port (redux-rs) in place of Java REDUX
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_redux` and `rust_ports` profiles. The image's `redux` command takes
    the same options as Java REDUX. redux-rs peaks below 2 GB on a whole genome. It does not
    draw the base-quality plot (`-bqr_write_plot`); every other output file is written.
----------------------------------------------------------------------------------------
*/

process {
    withName: 'REDUX' {
        container = params.rust_ports_container
        memory    = { 8.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container. Kept in its
// own file so that beforeScript is only set then: setting it here, even to null, would replace a
// beforeScript the run's own config gives every process (such as the Google Batch `mv` workaround).
includeConfig params.rust_ports_bin ? 'redux.native.config' : '/dev/null'

env {
    REDUX_JAVA_COMPAT = params.rust_java_compat ? '1' : '0'
}
