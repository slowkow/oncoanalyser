/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CUPPA: run the Rust port (cuppa-rs) in place of Java CUPPA and pycuppa
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_cuppa` and `rust_ports` profiles. The task's two commands run as they are: the image's
    `cuppa` (CuppaDataPrep) and `python -m cuppa.predict` (a stand-in that runs `cuppa-rs predict`; the image has
    no Python). The plot (`<sample>.cuppa.vis.png`, drawn with R) is not drawn; ORANGE takes CUPPA without it.
    pycuppa's numbers depend on the machine's BLAS in the last digits; the port gives those of its macOS
    references. cuppa-rs peaks at about 0.1 GB (Java and Python: about 0.5 GB).
----------------------------------------------------------------------------------------
*/

process {
    withName: 'CUPPA' {
        // -java_compat (Java's and pycuppa's behaviour) from --rust_java_compat, on both command lines: Google Batch
        // does not pass the env scope to tasks. Empty when not set, so the task script (and the -resume cache) is
        // then the same as without these lines.
        ext.args  = { params.rust_java_compat ? '-java_compat' : '' }
        ext.args2 = { params.rust_java_compat ? '-java_compat' : '' }
        // a closure, read as each task starts, so that a value set in a -c config counts too
        // (Nextflow then warns once at start-up that the parameter is undefined; harmless)
        container = { params.rust_ports_container }
        memory    = { 2.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container. Kept in its
// own file so that beforeScript is only set then: setting it here, even to null, would replace a
// beforeScript the run's own config gives every process (such as the Google Batch `mv` workaround).
includeConfig params.rust_ports_bin ? 'cuppa.native.config' : '/dev/null'
