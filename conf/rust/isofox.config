/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ISOFOX: run the Rust port (isofox-rs) in place of Java ISOFOX
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_isofox` and `rust_ports` profiles, for ISOFOX_QUANTIFICATION and NEO_ANNOTATE_FUSIONS. The image's
    `isofox` command takes Java ISOFOX's options. isofox-rs reproduces the ISOFOX version each RNA route runs in Java:
    2.0.1 with `--rna_aligner star` (STAR BAMs), 2.1 with `bwa-mem3` (TARS BAMs), chosen here with -isofox_version.
    isofox-rs peaks at about a third of Java's memory (a tumor RNA slice: 1.6-1.9 GB against 6.1-6.2 GB).
----------------------------------------------------------------------------------------
*/

process {
    withName: 'ISOFOX|NEO_ANNOTATE_FUSIONS' {
        // the version for the RNA route, and -java_compat (Java's behaviour) from --rust_java_compat, on the command
        // line: Google Batch does not pass the env scope to tasks
        ext.args  = { (params.rna_aligner == 'star' ? '-isofox_version 2.0.1' : '-isofox_version 2.1') + (params.rust_java_compat ? ' -java_compat' : '') }
        // a closure, read as each task starts, so that a value set in a -c config counts too
        container = { params.rust_ports_container }
        memory    = { 16.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container.
includeConfig params.rust_ports_bin ? 'isofox.native.config' : '/dev/null'
