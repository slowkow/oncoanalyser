/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ISOFOX: run the Rust port (isofox-rs) in place of Java ISOFOX
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Used by the `rust_isofox` profile only, not by `rust_ports`: isofox-rs follows ISOFOX 2.1, which expects RNA
    aligned with `--rna_aligner bwa-mem3` (TARS, REDUX). With STAR (the default route) Java runs ISOFOX 2.0.1,
    whose behaviour on STAR BAMs the port does not reproduce yet. The image's `isofox` command takes Java ISOFOX's
    options, for ISOFOX_QUANTIFICATION and NEO_ANNOTATE_FUSIONS. isofox-rs peaks at about a quarter of Java's
    memory (a tumor RNA slice: 1.6 GB against 6.2 GB).
----------------------------------------------------------------------------------------
*/

process {
    withName: 'ISOFOX|NEO_ANNOTATE_FUSIONS' {
        // -java_compat (Java's behaviour) from --rust_java_compat, on the command line: Google Batch does not
        // pass the env scope to tasks. Empty when not set, so the task script (and the -resume cache) is
        // then the same as without this line.
        ext.args  = { params.rust_java_compat ? '-java_compat' : '' }
        // a closure, read as each task starts, so that a value set in a -c config counts too
        container = { params.rust_ports_container }
        memory    = { 16.GB * task.attempt }
    }
}

// With --rust_ports_bin the port runs from that folder on the host, without a container.
includeConfig params.rust_ports_bin ? 'isofox.native.config' : '/dev/null'
