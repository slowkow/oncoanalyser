// Included by cuppa.config when --rust_ports_bin is given: run the port from that folder on the host
// (the folder's `python` stand-in then comes before the host's Python on PATH, for this task only)
process {
    withName: 'CUPPA' {
        container    = null
        beforeScript = "export PATH=\"${params.rust_ports_bin}:\$PATH\""
    }
}
