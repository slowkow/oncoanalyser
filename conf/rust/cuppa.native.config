// Included by cuppa.config when --rust_ports_bin is given: run the port from that folder on the host
// (with its cuppa-shim/ folder first, whose `python` runs `python -m cuppa.predict` as cuppa-rs, for this task only)
process {
    withName: 'CUPPA' {
        container    = null
        beforeScript = "export PATH=\"${params.rust_ports_bin}/cuppa-shim:${params.rust_ports_bin}:\$PATH\""
    }
}
